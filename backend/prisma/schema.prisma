generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  Admin
  Manager
  Employee
}

/// Lifecycle order. `Done` means an approver has verified the work — a worker
/// reporting completion moves the task to `Submitted`, not `Done`, so the
/// board never claims something is finished on the strength of a WhatsApp
/// message alone.
enum TaskStatus {
  Pending
  InProgress
  Submitted // worker says it's finished; awaiting review
  Done // reviewed and approved
  Issue
  Delay
}

enum Priority {
  Low
  Medium
  High
}

/// What kind of work a task is.
///
/// A column rather than a `customFields` key so "show me every open payment
/// follow-up" is an index scan rather than a scan over JSON. `internal` is the
/// default, so every task that existed before this — and every task the
/// dashboard creates without saying otherwise — is unaffected.
enum TaskKind {
  internal
  sample_dispatch
  payment_followup
  stock_check
  sales
}

/// What an external party is to us. Drives which template a message to them
/// uses and, for payments, which direction the money is going.
enum ContactType {
  customer
  vendor
  seller
  supplier
  buyer
  other
}

enum InvoiceStatus {
  open
  partial
  paid
  cancelled
}

enum MessageDirection {
  inbound
  outbound
}

enum MessageKind {
  text
  image
  document
  video
  voice
  interactive
  system
}

/// Mirrors WhatsApp's own delivery lifecycle, driven by Meta's status webhook.
/// Ordering matters: status only ever moves forward, so a late-arriving "sent"
/// must not overwrite a "read" (see DELIVERY_RANK in webhookController).
enum DeliveryStatus {
  pending // queued locally, not yet handed to Meta
  sent // Meta accepted it — one grey tick
  delivered // reached the recipient's device — two grey ticks
  read // opened by the recipient — two blue ticks
  failed
}

/// How a task's ownership works.
///
/// `sole` is every task that has ever existed here: one person owns it. `shared`
/// means several people hold the same task and each must submit their own part
/// before it goes for approval — which is the distinction between "you two work
/// on this together" and "you each do this separately", and the reason those two
/// phrasings must never be guessed between.
enum AssignmentMode {
  sole
  shared
}

/// Where an action came from. Stored as a column rather than baked into the
/// activity text so "what did WhatsApp change today?" is a query, not a LIKE.
enum ActionChannel {
  web
  whatsapp
  system // the escalation cron and other unattended writers
}

/// Lifecycle of a management command issued over WhatsApp.
///
/// `clarifying` and `awaiting_confirmation` are terminal for THIS message but
/// not for the conversation — a follow-up reply produces a new row that ends in
/// `executed` or `cancelled`. Keeping them distinct is what makes "how often do
/// we have to ask twice?" answerable.
enum CommandStatus {
  executed
  clarifying
  awaiting_confirmation
  cancelled
  rejected // failed authorization or a business rule
  failed // unexpected error — a bug, not a refusal
}

/// How a message came to be linked to a task. Recorded so a misroute is
/// queryable after the fact instead of buried in a text string.
enum AttributionSource {
  explicit_ref // worker named it — "TSK-1060" / "task 1060" / "टास्क 1060"
  reply_context // worker tapped a template button, or swipe-replied, on a message about this task
  list_reply // worker picked it from the WhatsApp list we sent
  single_open_task // exactly one candidate existed — no guess involved
  recent_context // follow-up inside the context window ("also done")
  manual // an Admin/Manager re-attributed it in the UI
  none // deliberately left unattributed
}

model User {
  id                String  @id @default(cuid())
  name              String
  email             String  @unique
  passwordHash      String
  role              Role    @default(Employee)
  reportingToId     String?
  reportingTo       User?   @relation("tree", fields: [reportingToId], references: [id])
  reports           User[]  @relation("tree")
  phone             String?
  /// Picks the WhatsApp template language. Only codes listed in APPROVED_LANGS
  /// (whatsappService.ts) have templates in Meta; anything else falls back to
  /// English at send time.
  preferredLanguage String  @default("en") // "en" | "hi"
  avatar            String  @default("")
  color             String  @default("from-slate-400 to-slate-600")

  /// Set when somebody has left. They keep every task, activity and message
  /// they ever touched — the audit trail is the reason those foreign keys are
  /// RESTRICT — but they can no longer sign in, be assigned work, or clutter
  /// the team list.
  ///
  /// This exists because hard deletion is impossible for anyone who has done
  /// anything: the schema protects their footprint, correctly, which left
  /// "Remove Member" working only for people who had never been given a task.
  deactivatedAt DateTime?

  createdAt DateTime @default(now())

  assignedTasks Task[]     @relation("Assignee")
  createdTasks  Task[]     @relation("Creator")
  activities    Activity[]

  /// Every task this person holds, sole or shared. `assignedTasks` covers only
  /// the ones they are primary on.
  assignments TaskAssignee[] @relation("Assignments")

  /// Messages in THIS person's WhatsApp conversation (they own the phone number).
  conversation Message[] @relation("ConversationOwner")
  /// Messages this person produced — for outbound, that's the manager, not the owner.
  sentMessages Message[] @relation("MessageSender")

  /// Management commands this person issued over WhatsApp.
  commands          WhatsAppCommand[]  @relation("CommandSender")
  /// At most one in-flight clarification/confirmation per person.
  conversationState ConversationState? @relation("ConvState")

  /// External parties this person is responsible for.
  contacts Contact[] @relation("ContactOwner")
}

model Task {
  id          String @id @default(cuid())
  title       String
  description String @default("")

  /// The PRIMARY assignee, and still required.
  ///
  /// Multi-assignee is layered on top of this rather than replacing it, which
  /// is deliberate: `assignedToId` is read in a dozen backend files and
  /// seventeen frontend ones, and every one of them keeps working unchanged.
  /// For a `sole` task it is the only assignee. For a `shared` task it is the
  /// owner of record — the person the task is filed under — while `assignees`
  /// carries the full set.
  assignedToId String
  assignedTo   User   @relation("Assignee", fields: [assignedToId], references: [id])

  assignedById String
  assignedBy   User   @relation("Creator", fields: [assignedById], references: [id])

  assignmentMode AssignmentMode @default(sole)
  /// One row per person holding this task, including the primary. Always
  /// populated — a sole task has exactly one — so nothing has to branch on
  /// whether the join table applies.
  assignees      TaskAssignee[]

  /// Set when this task was created by copying another. Kept as SetNull rather
  /// than Cascade: deleting an original must not delete the copies made from
  /// it, which are real work assigned to real people.
  sourceTaskId String?
  sourceTask   Task?   @relation("TaskCopies", fields: [sourceTaskId], references: [id], onDelete: SetNull)
  copies       Task[]  @relation("TaskCopies")

  /// What kind of work this is. Defaults to `internal`, so every row that
  /// existed before this — and every task the dashboard creates without saying
  /// otherwise — keeps its current meaning.
  kind TaskKind @default(internal)

  /// The external party this task is ABOUT, when there is one: the customer
  /// whose dues are being collected, the seller being asked about stock.
  ///
  /// Never the assignee. `assignedToId` stays required and stays a `User`,
  /// because somebody on our team always owns chasing this. SetNull rather
  /// than Cascade — removing a contact must not delete the work done for them.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  /// The bill this task is chasing, for payment follow-ups.
  invoiceId String?
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  status          TaskStatus @default(Pending)
  priority        Priority   @default(Medium)
  deadline        DateTime
  escalationLevel Int        @default(0)
  approved        Boolean    @default(false)
  customFields    Json       @default("{}")
  alertDispatched Boolean    @default(false)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  activities Activity[]
  messages   Message[]

  @@index([sourceTaskId])
  @@index([kind, status])
  @@index([contactId])
  @@index([invoiceId])
}

/// One person's hold on a task.
///
/// The per-person `status` is what makes a shared task honest. Without it,
/// either assignee saying "done" would close the work for both, and there would
/// be no record of who actually did what — so a shared task only reaches
/// `Submitted` when every row here has.
model TaskAssignee {
  id String @id @default(cuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation("Assignments", fields: [userId], references: [id], onDelete: Cascade)

  /// This person's own progress, independent of everyone else's.
  status      TaskStatus @default(Pending)
  submittedAt DateTime?

  /// Who put them on it. Answers "who added Vedant to this?" without digging
  /// through the activity log.
  addedById String
  createdAt DateTime @default(now())

  /// A person can hold a task once. Makes "also assign task 4 to Vedant" when
  /// Vedant already has it a no-op at the database level, not just in code.
  @@unique([taskId, userId])
  @@index([userId, status])
}

/// The per-task audit log. Unchanged — every status change, approval,
/// escalation and reassignment lands here, and `taskId` stays required.
/// WhatsApp messages live in `Message`, not here.
model Activity {
  id            String  @id @default(cuid())
  taskId        String
  task          Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  byId          String
  by            User    @relation(fields: [byId], references: [id])
  type          String
  text          String
  mediaUrl      String? // Cloudinary URL for WhatsApp image/document/audio attachments
  transcription String? // Whisper ASR transcript (voice notes only, null otherwise)

  /// Which interface produced this change. A column rather than a phrase glued
  /// onto `text`, so "what did WhatsApp change today?" is a query. Defaults to
  /// `web` — every row written before this existed came from the dashboard.
  channel ActionChannel @default(web)

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@index([type, createdAt])
  @@index([channel, createdAt])
}

/// One row per real WhatsApp message.
///
/// WhatsApp gives each phone number ONE conversation with ONE rolling 24h
/// session. Grouping by `userId` reproduces that conversation exactly, which
/// is the whole point of this model: a message no longer has to belong to a
/// task, so an unroutable one can stay unattributed instead of being guessed
/// onto the wrong task.
model Message {
  id String @id @default(cuid())

  /// Conversation owner — whoever owns the phone number this thread belongs to.
  /// NOT the actor. On outbound messages the actor is the manager; the owner is
  /// still the employee being messaged.
  ///
  /// Nullable since contacts arrived: a thread with an external party has no
  /// owning employee. EXACTLY ONE of `userId` and `contactId` is set, enforced
  /// by a check constraint (prisma/sql/) because Prisma cannot express XOR.
  /// Read it through `conversationKey()` rather than testing for null at each
  /// of the two dozen call sites.
  userId String?
  user   User?   @relation("ConversationOwner", fields: [userId], references: [id], onDelete: Cascade)

  /// Conversation owner when the other end is an external party.
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)

  /// Who produced this message. Null when a contact sent it — they are not a
  /// `User` and never will be. For outbound to a contact this is the employee
  /// who caused the send.
  senderId String?
  sender   User?   @relation("MessageSender", fields: [senderId], references: [id])

  direction MessageDirection
  kind      MessageKind      @default(text)

  /// Nullable on purpose. SetNull rather than Cascade — deleting a task must
  /// never delete the conversation history that mentioned it.
  ///
  /// Note on reassignment: if a task moves to another person, existing messages
  /// keep the original `userId`. That is correct — they really did say it — so
  /// the new assignee's conversation legitimately has no history for that task.
  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: SetNull)

  attributedBy AttributionSource @default(none)

  /// Set when the worker reported an actionable outcome we could not route.
  /// Drives the amber chip in the tracker and the WhatsApp list we send back.
  needsAttribution Boolean @default(false)

  /// Parked so a later list-reply can apply the ORIGINAL intent to whichever
  /// task the worker eventually picks.
  intentAction     String? // "done" | "issue" | "delay" | "progress"
  intentConfidence String? // "ai" | "keyword" | "none"

  text          String  @default("")
  mediaUrl      String?
  transcription String?

  /// Meta's wamid. Unique, so a retried webhook delivery is a no-op rather
  /// than a duplicate message and a second status change.
  waMessageId String? @unique

  deliveryStatus DeliveryStatus @default(sent)
  deliveryError  String?

  /// Set only by prisma/backfill-messages.ts, so re-running it is a no-op.
  legacyActivityId String? @unique

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, direction, createdAt])
  @@index([taskId, createdAt])
  @@index([userId, needsAttribution])
  @@index([contactId, createdAt])
  @@index([contactId, direction, createdAt])
}

/// Audit row for a management command issued over WhatsApp ("assign TSK-1059
/// to Vikranth").
///
/// Separate from `Activity` on purpose. `Activity` records what happened TO A
/// TASK and requires a `taskId`; this records what somebody ASKED FOR, which
/// is a different question and frequently has no valid task at all — a command
/// naming a ticket that doesn't exist is precisely the thing an auditor needs
/// to see. Every command lands here, including the ones we refuse.
model WhatsAppCommand {
  id String @id @default(cuid())

  senderId String
  sender   User   @relation("CommandSender", fields: [senderId], references: [id], onDelete: Cascade)

  /// Last 4 digits only. `senderId` is the secure reference and `User.phone`
  /// already holds the number once — this exists so an operator reading the
  /// audit log can tell two devices apart without the table becoming a second
  /// copy of everyone's phone number.
  senderPhoneLast4 String @default("")

  /// Meta's wamid for the message that carried this command, and our own
  /// `Message` row. Both nullable: a command can also arrive as the second
  /// turn of a confirmation, and message creation can fail independently.
  waMessageId String?
  messageId   String?

  rawText       String  @default("")
  /// Set when the command arrived as a voice note. The transcript is what was
  /// actually acted on, so it is retained with the decision, not just the audio.
  transcription String?

  /// What we understood. `entities` is the full parsed struct — deliberately
  /// Json, because the AI layer's shape will keep growing and an audit record
  /// should capture what the model actually said, not a lossy projection.
  intent     String?
  entities   Json    @default("{}")
  confidence Float?

  /// No foreign key on `taskId`. A command that named a nonexistent ticket has
  /// to stay auditable, and an FK would make that row impossible to write.
  taskId             String?
  previousAssigneeId String?
  newAssigneeId      String?

  channel ActionChannel @default(whatsapp)

  /// True when the sender explicitly confirmed before we acted.
  confirmed Boolean @default(false)

  status      CommandStatus
  /// Why we refused, in the same words the sender was given.
  errorReason String?

  /// Set when this command was later undone. Together with previousAssigneeId
  /// this row IS the undo log — "undo the last assignment" finds the sender's
  /// most recent executed command that has not been reversed, and a command can
  /// only be undone once.
  undoneAt          DateTime?
  undoneByCommandId String?

  createdAt DateTime @default(now())

  @@index([senderId, createdAt])
  @@index([status, createdAt])
  @@index([taskId, createdAt])
}

/// An in-flight clarification or confirmation.
///
/// `userId` is unique: one pending question per person. A second command while
/// one is open replaces it rather than queueing, which matches how the
/// conversation actually reads — the newest thing you said is what you meant.
///
/// Bound to the resolved user id, never to a phone number from the payload, so
/// a confirmation cannot be redirected by spoofing `from`.
model ConversationState {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation("ConvState", fields: [userId], references: [id], onDelete: Cascade)

  /// "confirm" — waiting for yes/no on a fully-resolved command.
  /// "choose_employee" — waiting for the sender to pick between similar names.
  /// "choose_task" — waiting for the sender to say which ticket they meant.
  kind String

  /// The command being held, serialised. Re-validated from scratch when it is
  /// finally executed — this is a draft, never a grant of authority.
  payload Json

  /// What we offered them, so a reply of "2" is resolvable.
  options Json @default("[]")

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// An external party: a customer, vendor, seller, supplier or buyer.
///
/// Deliberately NOT a `User`. A `User` has a `passwordHash`, a `Role` and a
/// `reportingToId`; it appears in team lists, workload charts, the org tree,
/// `assignableUsers()` and the assignee picker, and it can be given tasks.
/// Putting a vendor in that table would put them in every one of those places,
/// and the only thing they actually share with an employee is a phone number.
///
/// `ownerId` is who at our end is responsible for this relationship — it is
/// what makes "which contacts may this Admin message?" answerable, and that
/// question is the permission boundary for outbound messaging exactly as
/// `assignableUsers()` is for task assignment.
model Contact {
  id          String      @id @default(cuid())
  name        String
  companyName String?
  /// Normalised to E.164 digits before it is stored, so the inbound webhook's
  /// last-ten-digits match and outbound sends agree on one representation.
  ///
  /// Unique across contacts, and refused at creation when it collides with a
  /// live `User.phone` — otherwise an inbound message from that number would
  /// have two possible senders and the webhook would have to guess.
  phone       String      @unique
  type        ContactType @default(other)
  email       String?
  address     String?
  notes       String      @default("")

  /// Other names this party is known by — a trading name, a short form, the
  /// other script. Fed to name resolution as extra candidates pointing at this
  /// same row, which is how "Ramesh Traders" and "रमेश ट्रेडर्स" both land here.
  aliases String[] @default([])

  /// Whatever account, party or GST code the client already uses. Never
  /// generated here — this is a place to record theirs, not to invent ours.
  externalRef String?

  /// Same "en" | "hi" contract as User.preferredLanguage: picks the template
  /// suffix, falling back to English when the language is not approved.
  preferredLanguage String @default("en")

  ownerId String
  owner   User   @relation("ContactOwner", fields: [ownerId], references: [id])

  /// Consent to be messaged. Recorded but NOT currently required to send —
  /// see WA_REQUIRE_OPTIN. `optOutAt` is enforced unconditionally: a party who
  /// replies STOP is never messaged again, which is not the same question as
  /// whether they opted in to begin with.
  optInAt  DateTime?
  optOutAt DateTime?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  invoices Invoice[]
  tasks    Task[]
  messages Message[]

  @@index([ownerId, archivedAt])
  @@index([type, archivedAt])
}

/// A bill, in either direction.
///
/// Exists so a reminder can quote what is actually outstanding rather than
/// whatever number somebody typed into WhatsApp. When a command names a
/// reference we hold, the amount comes from here and the typed one is ignored;
/// when it names one we do not, the sender is told so before anything is sent.
model Invoice {
  id        String  @id @default(cuid())
  /// "INV-102". Unique, so a reference resolves to exactly one bill.
  number    String  @unique
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  /// Decimal, never Float. Binary floating point cannot represent 0.10, and
  /// this number goes into a message asking somebody for money.
  amount   Decimal @db.Decimal(14, 2)
  currency String  @default("INR")
  /// What is still outstanding. Reminders quote THIS, not `amount` — a bill
  /// half paid should not be chased for its original value.
  balance  Decimal @db.Decimal(14, 2)

  dueDate DateTime
  status  InvoiceStatus @default(open)

  /// True when we owe them (a vendor bill), false when they owe us (a sales
  /// invoice). Picks between the two payment templates, which say opposite
  /// things and must never be swapped.
  payable Boolean @default(false)

  notes       String   @default("")
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]

  @@index([contactId, status])
  @@index([status, dueDate])
}
