PORT=5005
NODE_ENV=development

# Neon PostgreSQL connection string
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# JWT
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Meta WhatsApp Cloud API
# Get from: developers.facebook.com → Your App → WhatsApp → API Setup
META_PHONE_ID="your_phone_number_id"
META_ACCESS_TOKEN="EAAxxxxx..."
META_VERIFY_TOKEN="flowdesk-webhook-secret"

# CORS — frontend origin
FRONTEND_URL="http://localhost:5173"

# Cloudinary — media storage for WhatsApp image/doc/audio attachments
# Sign up free at cloudinary.com → Dashboard → copy these 3 values
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# ── Voice Note Transcription ─────────────────────────────────────────────────
# Uses Groq Whisper (primary) — free tier: 7 200 audio min/day, ~200× real-time
# Sign up free at console.groq.com → API Keys
GROQ_API_KEY="gsk_xxxxxxxxxxxx"
# Override default Groq model (optional):
#   whisper-large-v3-turbo   ← default (fast + multilingual: EN/HI/MR)
#   whisper-large-v3         ← slightly more accurate
GROQ_ASR_MODEL="whisper-large-v3-turbo"

# OpenAI Whisper — fallback if no GROQ_API_KEY (paid, ~$0.006/min)
# Leave blank if you have a Groq key
OPENAI_API_KEY=""

# ── Intent Detection (NVIDIA NIM) ────────────────────────────────────────────
# A lightweight model reads each inbound message / voice-note transcript and
# works out both WHAT the worker is reporting (done / issue / delay / progress)
# and WHICH task they meant — including loose forms like "task 1058 completed",
# "Tsk 1058", "task -1058", or "टास्क 1058".
#
# Reuses NVIDIA_API_KEY above. Without it the service falls back to multilingual
# keyword matching plus regex task-number extraction — still functional, but
# weaker on phrasing it hasn't seen.
#
# Benchmarked on real tracker messages (9 cases: EN + Hindi + noisy transcripts):
#   meta/llama-3.1-8b-instruct   9/9, ~0.7s   ← default
#   meta/llama-3.2-3b-instruct   9/9, ~0.9s   ← smaller, equally accurate here
#   nvidia/nemotron-nano-9b-v2   1/9, ~3s     ← avoid: reasoning model, its
#                                               chain-of-thought breaks JSON
NVIDIA_INTENT_MODEL="meta/llama-3.1-8b-instruct"

# ── WhatsApp Management Commands ─────────────────────────────────────────────
# Lets a manager run the task board from WhatsApp:
#   "Allocate task TSK-1059 to Vikranth"
#   "Create a task for Vedant to prepare the weekly report by Friday"
#   "Set the priority of TSK-1059 to high"
# Voice notes work too — they go through the same transcription and validation.
#
# SHIPS DISABLED. Existing deployments already have managers' phone numbers
# registered, so turning this on is a decision somebody has to make rather than
# something an upgrade does to them. The server logs which state it booted in.
WA_COMMANDS_ENABLED="false"

# Who may issue commands. Employees never can — they report on their own tasks.
WA_COMMAND_ROLES="Manager,Admin"

# How long a pending confirmation or "which Vikranth did you mean?" stays
# answerable, in seconds. After this the reply is ignored and nothing happens.
WA_STATE_TTL_S="600"

# Blast-radius limit, per sender. Not spam protection (the webhook is already
# authenticated and deduplicated) — this caps how much damage a stolen phone or
# a looping integration can do before anyone notices.
WA_COMMAND_RATE_LIMIT="20"
WA_COMMAND_RATE_WINDOW_S="600"

# How confident the parse must be before a ticket moves without the sender
# saying yes. The AI layer clamps its own self-reported confidence to this same
# value, so raising it above 0.9 makes EVERY AI-parsed command ask first.
# Exact-name commands matched by the rule parser are unaffected.
WA_CONFIDENCE_THRESHOLD="0.9"

# How far back "undo the last assignment" can reach, in seconds. An action
# older than this is history, not a mistake still worth reversing.
WA_UNDO_WINDOW_S="3600"

# How far back a bare "send this to Vedant" may reach for a file the sender
# uploaded a moment ago. More than one candidate in the window is a question,
# never a guess — forwarding the wrong file cannot be taken back.
WA_ATTACHMENT_WINDOW_S="900"

# ─── Outreach: messaging people outside the company ──────────────────────────
#
# Everything below governs sending to a customer, vendor, seller or supplier —
# somebody who is not an employee and did not choose to be in this system.
#
# Meta's quality rating is per phone NUMBER, and it is the same number the
# internal task flow runs on. A vendor reporting the business as spam degrades
# delivery for every employee notification too. That is why these defaults are
# conservative and why the whole capability ships off.

# The master switch. Off by default, exactly like WA_COMMANDS_ENABLED — turning
# it on is a deliberate act, not something an upgrade does for you.
WA_OUTREACH_ENABLED="false"

# Who may message an outside party. Deliberately SEPARATE from
# WA_COMMAND_ROLES: a Manager who can reassign a ticket should not thereby be
# able to send a vendor a bill.
WA_OUTREACH_ROLES="Admin"

# Above this rupee amount a confirmation spells the figure out in words as well
# as digits, so it cannot be skimmed past. Every outbound message to a party is
# confirmed regardless — this only changes how loudly.
WA_CONFIRM_AMOUNT="100000"

# Per-contact limits, both database-backed so they survive a restart and a
# second process. The cooldown is the minimum gap between two messages to the
# same party; the cap is the hard ceiling per rolling 24 hours. A scheduled
# follow-up is exempt from the cooldown but never from the cap, which is the
# backstop against a runaway reminder ladder.
WA_CONTACT_COOLDOWN_S="86400"
WA_CONTACT_DAILY_CAP="3"

# The reminder ladder. After MAX_CHASES the party is left alone and the
# internal owner is told to call them instead — an unbounded ladder is how a
# number gets reported.
WA_OUTREACH_MAX_CHASES="2"
WA_OUTREACH_CHASE_GAP_H="72"

# Whether a recorded opt-in is REQUIRED before we may message somebody.
#
# Currently false, which is the client's explicit decision. Meta does require
# opt-in; the Contact.optInAt column is populated regardless so that turning
# this on later is a config change rather than a migration and a backfill.
#
# Note this is not the same question as opt-OUT, which is always honoured: a
# party who replies STOP is never messaged again whatever this is set to.
WA_REQUIRE_OPTIN="false"

# What appears as {{2}} in every outreach template — the "from" line the
# recipient sees. Leave unset to use the sending employee's own name, which is
# what the approved template samples show.
COMPANY_NAME=""
